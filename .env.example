# API (apps/api)
PORT=4000
# Leave empty to use embedded Postgres (PGlite). Set for a real Postgres server:
DATABASE_URL=
# Where PGlite keeps its files when DATABASE_URL is empty (empty = in memory)
DATA_DIR=.data
CORS_ORIGIN=http://localhost:3000
# Payments: leave empty for the built-in test provider. Adyen TEST key enables real test-mode Checkout sessions.
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
# 1 = never call Frankfurter, always use the ECB snapshot
RATES_OFFLINE=0

# Web (apps/web) – leave empty for demo mode (runs fully in the browser)
NEXT_PUBLIC_API_URL=
# Mobile (apps/mobile)
EXPO_PUBLIC_API_URL=
